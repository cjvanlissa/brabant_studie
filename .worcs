worcs_version: 0.1.20
creator: cjvanlissa
entry_point: manuscript/manuscript.Rmd
recipe:
  recipe: targets::tar_make()
  terminal: no
data:
  dict.RData:
    save_expression: saveRDS(dict, "dict.RData")
    load_expression: readRDS("dict.RData")
  desc.csv:
    save_expression: write.csv(x = data, file = filename, row.names = FALSE)
    load_expression: read.csv(file = filename, stringsAsFactors = TRUE)
  df.csv:
    save_expression: write.csv(x = data, file = filename, row.names = FALSE)
    load_expression: read.csv(file = filename, stringsAsFactors = TRUE)
    codebook: codebook_df.Rmd
    labels: value_labels_df.yml
checksums:
  dict.RData: 2e517c8bc2599c480258dffd3a836960
  desc.csv: ce754b0084c3c18a41a165f6cf81bab4
